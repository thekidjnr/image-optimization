+    // Video passthrough — bypass the image-processing Lambda entirely for video files.
+    //
+    // Videos are uploaded into the exact same bucket/folder layout as photos
+    // (workspaces/{workspaceId}/galleries/{galleryId}/files/{id}.ext — see
+    // lens_server/src/controllers/video.controller.ts and lens_dashboard/context/UploadContext.tsx),
+    // so origin routing can't key off a path prefix. It keys off the file extension instead:
+    // any request whose path ends in a known video extension is served straight from the
+    // original S3 bucket via its own cache behavior, skipping the CloudFront Function rewrite
+    // and the Sharp/Lambda pipeline (which can't parse video bytes and returns 400 for them).
+    const videoOrigin = origins.S3BucketOrigin.withOriginAccessControl(originalImageBucket, {
+      originAccessLevels: [cloudfront.AccessLevel.READ],
+    });
+
+    const VIDEO_PATH_PATTERNS = [
+      "*.mp4", "*.mov", "*.webm", "*.m4v",
+      "*.avi", "*.mkv", "*.wmv", "*.3gp", "*.ogv", "*.flv",
+    ];
+
+    for (const pattern of VIDEO_PATH_PATTERNS) {
+      imageDelivery.addBehavior(pattern, videoOrigin, {
+        viewerProtocolPolicy: cloudfront.ViewerProtocolPolicy.REDIRECT_TO_HTTPS,
+        compress: false,
+        cachePolicy: cloudfront.CachePolicy.CACHING_OPTIMIZED,
+      });
+    }
+
+    // `originalImageBucket` is imported by name (S3_IMAGE_BUCKET_NAME), not owned by this
+    // stack, so CDK cannot attach a bucket policy to it automatically —
